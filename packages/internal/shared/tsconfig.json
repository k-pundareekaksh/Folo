{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "skipLibCheck": true,
        "strict": false,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@follow/shared/env.desktop": [
                "packages/internal/shared/src/env.desktop.ts"
            ],
            "@follow/shared/*": [
                "packages/internal/shared/src/*"
            ],
            "@folo-services/ai-tools": [
                "packages/folo-services/ai-tools/src/index.ts"
            ]
        }
    },
    "include": [
        "tests/**/*",
        "apps/**/*",
        "packages/**/*"
    ]
}